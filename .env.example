# =============================================================================
# DocBook - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# Generate a strong secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Set to False in production, True for local development
DEBUG=False

# Comma-separated list of allowed host/domain names
# PythonAnywhere: username.pythonanywhere.com
# Custom domain: yourdomain.com
ALLOWED_HOSTS=127.0.0.1,localhost,.pythonanywhere.com

# Comma-separated list of trusted origins for CSRF (must include https://)
CSRF_TRUSTED_ORIGINS=https://yourdomain.pythonanywhere.com

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
DJANGO_LOG_LEVEL=WARNING
